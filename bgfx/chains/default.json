{   "name": "Default Nearest-Neighbor Filter with Defocus",
	"author": "Ryan Holtz",
	"targets": [
		{   "name": "temp",
			"mode": "guest",
			"bilinear": true,
			"user_prescale": true
		},
		{   "name": "defocus_temp",
			"mode": "guest",
			"bilinear": true,
			"user_prescale": true
		}
	],
	"passes": [
		{   "effect": "misc/blit",
			"name": "Copy To Filtered Texture",
			"input": [
				{ "sampler": "s_tex", "texture": "screen" }
			],
			"output": "temp"
		},
		{   "effect": "hlsl/defocus",
			"name": "Defocus Effect",
			"input": [
				{ "sampler": "s_tex", "target": "temp" }
			],
			"output": "defocus_temp",
			"uniforms": [
				{ "uniform": "u_defocus", "slider": "defocus" },
				{ "uniform": "u_overdrive_threshold", "slider": "defocus_overdrive_threshold" },
				{ "uniform": "u_overdrive_scale", "slider": "defocus_overdrive_scale" },
				{ "uniform": "u_overdrive_gamma", "slider": "defocus_overdrive_gamma" },
				{ "uniform": "u_overdrive_maxmul", "slider": "defocus_overdrive_maxmul" }
			]
		},
		{   "effect": "misc/blit",
			"name": "Final Upscale",
			"input": [
				{ "sampler": "s_tex", "target": "defocus_temp" }
			],
			"output": "output"
		}
	],
	"sliders": [
		{ "type": "vec2", "name": "defocus", "text": "Defocus, ", "default": [ 0.5, 0.5 ], "max": [ 2.0, 2.0 ], "min": [ 0.0, 0.0 ], "step": 0.1, "format": "%1.1f", "screen": "crt" },
		{ "type": "float", "name": "defocus_overdrive_threshold", "text": "Defocus Overdrive Threshold", "default": 0.75, "max": 1.00, "min": 0.00, "step": 0.01, "format": "%1.2f", "screen": "crt" },
		{ "type": "float", "name": "defocus_overdrive_scale",     "text": "Defocus Overdrive Scale",     "default": 1.00, "max": 4.00, "min": 0.00, "step": 0.01, "format": "%1.2f", "screen": "crt" },
		{ "type": "float", "name": "defocus_overdrive_gamma",     "text": "Defocus Overdrive Gamma",     "default": 2.20, "max": 4.00, "min": 0.10, "step": 0.01, "format": "%1.2f", "screen": "crt" },
		{ "type": "float", "name": "defocus_overdrive_maxmul",    "text": "Defocus Overdrive Max Mul",   "default": 2.00, "max": 4.00, "min": 1.00, "step": 0.01, "format": "%1.2f", "screen": "crt" }
	]
}
